# Copy this file to .env and set your local paths and credentials.

# Typical BlueStacks 5 path. A scrcpy or Android SDK adb.exe also works.
ADB_PATH=C:\Program Files\BlueStacks_nxt\HD-Adb.exe

# Optional serial; leave blank to select the connected phone/emulator in the dashboard.
ADB_SERIAL=

# OpenRouter API key. Keep this only in the ignored local .env file.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Frida is used only for WebView debugging when the app doesn't enable it itself.
FRIDA_PATH=C:\path\to\frida.exe
